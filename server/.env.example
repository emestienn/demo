NODE_ENV=development
PORT=4000

CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/dongne

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional — if set, the AI Assistant will enhance its rule-based itineraries
# with natural-language generation. The key is read only on the server and
# is never sent to the client.
OPENAI_API_KEY=
