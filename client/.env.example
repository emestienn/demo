# Points the client at the deployed API. For local development against
# `npm run dev` in server/, the defaults baked into src/api/client.js and
# src/hooks/useNotificationSocket.js already work without this file.
#
# For a Vercel deployment, set these as Vercel project environment variables
# to your Render backend's URL, e.g.:
#   VITE_API_URL=https://dongne-api.onrender.com/api/v1
#   VITE_SOCKET_URL=https://dongne-api.onrender.com
#   VITE_UPLOADS_URL=https://dongne-api.onrender.com

VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_UPLOADS_URL=http://localhost:4000
